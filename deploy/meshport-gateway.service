[Unit]
Description=Meshport HTTP device test gateway (console stays private)
After=network-online.target meshportd.service
Wants=network-online.target

[Service]
User=meshport
Group=meshport
Environment=XDG_DATA_HOME=/var/lib/meshport-gateway/data
Environment=XDG_CONFIG_HOME=/var/lib/meshport-gateway/config
ExecStart=/opt/meshport/bin/caddy run --config /etc/meshport/Caddyfile.client --adapter caddyfile
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/meshport-gateway
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
