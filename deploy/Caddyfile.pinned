# Device API only. Set MESHPORT_CLIENT_HOST to the public IP or DNS name.
# Use a stable server key; the enrollment certificate must be this certificate.
{
	admin off
	auto_https off
	# IP clients omit SNI; select this certificate even behind NAT.
	default_sni {$MESHPORT_CLIENT_HOST}
}

https://{$MESHPORT_CLIENT_HOST}:443 {
	tls /etc/meshport/tls/device.crt /etc/meshport/tls/device.key
	header X-Meshport-Entry devices-pinned
	@devices path /healthz /api/v1/devices/register /api/v1/devices/auth/challenge /api/v1/devices/auth/login /api/v1/ws /api/v1/me/device /api/v1/me/device/* /api/v1/peers /api/v1/messages /api/v1/messages/receipts /api/v1/rtc/ice-servers /api/v1/files /api/v1/files/* /api/v1/frp/nodes /api/v1/me/mappings /api/v1/me/mappings/* /api/v1/me/frpc /api/v1/me/frpc/* /api/v1/me/grants /api/v1/grants
	handle @devices {
		reverse_proxy 127.0.0.1:18080
	}
	handle {
		respond 404
	}
}

# Compatibility for existing HTTP devices; secure invitations cannot use HTTP.
:80 {
	@devices path /healthz /api/v1/devices/register /api/v1/devices/auth/challenge /api/v1/devices/auth/login /api/v1/ws /api/v1/me/device /api/v1/me/device/* /api/v1/peers /api/v1/messages /api/v1/messages/receipts /api/v1/rtc/ice-servers /api/v1/files /api/v1/files/* /api/v1/frp/nodes /api/v1/me/mappings /api/v1/me/mappings/* /api/v1/me/frpc /api/v1/me/frpc/* /api/v1/me/grants /api/v1/grants
	handle @devices {
		reverse_proxy 127.0.0.1:18080
	}
	handle {
		respond 404
	}
}
